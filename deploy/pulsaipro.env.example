# Copy to /etc/pulsaipro.env on the server, fill in the real values, then:
#   chown root:www-data /etc/pulsaipro.env && chmod 640 /etc/pulsaipro.env
#
# Values are the same ones currently set in the Vercel project — copy them from
# Vercel → Settings → Environment Variables, or from .env.local. The install script never
# touches this file, so redeploying is safe.

# --- The site's own address. Used for canonical URLs, JSON-LD, sitemap and channel links. ---
NEXT_PUBLIC_SITE_URL=https://pulsaipro.ru

# --- Supabase (unchanged by the move; the database stays where it is) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI ---
OPENAI_API_KEY=
# Cheap model for the market notes; strong one for the guides. Defaults in the code are
# gpt-5-mini and gpt-6-astra, so both lines are optional.
OPENAI_MODEL=gpt-5-mini
OPENAI_EVERGREEN_MODEL=gpt-6-astra
OPENAI_IMAGE_MODEL=gpt-image-2

# --- Market data ---
FINNHUB_API_KEY=
COINGECKO_API_KEY=

# --- Telegram: alerts to the owner, the public channel, and the bot webhook ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
TELEGRAM_CHANNEL_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# --- Analytics ---
NEXT_PUBLIC_YANDEX_METRIKA_ID=

# --- Shared secret the cron endpoints check in the Authorization header ---
# Generate a fresh one for the new host: openssl rand -hex 32
CRON_SECRET=
